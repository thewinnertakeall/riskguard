@prefix rg: <http://riskguard.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# ONTOLOGY DECLARATION
# ============================================================
<http://riskguard.org/ontology> a owl:Ontology ;
    rdfs:label "RiskGuard Occupational Risk Ontology" ;
    rdfs:comment "Ontología OWL-DL para la gestión semántica de riesgos ocupacionales e ISO 31000" ;
    owl:versionInfo "1.0.0" .

# ============================================================
# CLASSES (TBox)
# ============================================================
rg:Risk a owl:Class ;
    rdfs:label "Riesgo" ;
    rdfs:comment "Un evento incierto que puede impactar los objetivos de la organización." .

rg:TechnologicalRisk a owl:Class ;
    rdfs:subClassOf rg:Risk ;
    rdfs:label "Riesgo Tecnológico" .

rg:SocialRisk a owl:Class ;
    rdfs:subClassOf rg:Risk ;
    rdfs:label "Riesgo Social" .

rg:NaturalRisk a owl:Class ;
    rdfs:subClassOf rg:Risk ;
    rdfs:label "Riesgo Natural" .

# Inferred Classes
rg:CriticalRisk a owl:Class ;
    rdfs:subClassOf rg:Risk ;
    rdfs:label "Riesgo Crítico" .

rg:PriorityRisk a owl:Class ;
    rdfs:subClassOf rg:CriticalRisk ;
    rdfs:label "Riesgo Prioritario" .

rg:Control a owl:Class ;
    rdfs:label "Control" .

rg:Incident a owl:Class ;
    rdfs:label "Incidente" .

rg:Cause a owl:Class ;
    rdfs:label "Causa" .

rg:Process a owl:Class ;
    rdfs:label "Proceso" .

rg:Area a owl:Class ;
    rdfs:label "Área" .

rg:Location a owl:Class ;
    rdfs:label "Ubicación" .

# ============================================================
# OBJECT PROPERTIES (Relaciones)
# ============================================================
rg:hasControl a owl:ObjectProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Control ;
    rdfs:label "tiene control" .

rg:hasIncident a owl:ObjectProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Incident ;
    rdfs:label "tiene incidente registrado" .

rg:hasCause a owl:ObjectProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Cause ;
    rdfs:label "es provocado por la causa" .

rg:belongsToProcess a owl:ObjectProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Process .

rg:belongsToArea a owl:ObjectProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Area .

rg:locatedIn a owl:ObjectProperty ;
    rdfs:range rg:Location .

# ============================================================
# DATATYPE PROPERTIES (Atributos Tipados)
# ============================================================
rg:riskScore a owl:DatatypeProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:integer .

rg:probability a owl:DatatypeProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:integer .

rg:impact a owl:DatatypeProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:integer .

rg:severity a owl:DatatypeProperty ;
    rdfs:domain rg:Incident ;
    rdfs:range xsd:string .

rg:requiresPriorityAttention a owl:DatatypeProperty ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:boolean .
