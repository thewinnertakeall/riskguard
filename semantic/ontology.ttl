@prefix rg: <http://riskguard.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# ============================================================
# ONTOLOGY
# ============================================================

rg:RiskGuardOntology
    a owl:Ontology ;
    rdfs:label "RiskGuard Occupational Risk Management Ontology" ;
    rdfs:comment "Ontology for representing occupational risks, causes, controls, incidents, processes, areas and locations." .


# ============================================================
# CLASSES
# ============================================================

rg:Risk
    a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "Occupational risk identified within an organizational process." .


rg:Cause
    a owl:Class ;
    rdfs:label "Cause" ;
    rdfs:comment "Cause associated with the occurrence of an occupational risk." .


rg:Control
    a owl:Class ;
    rdfs:label "Control" ;
    rdfs:comment "Control measure implemented to reduce or manage a risk." .


rg:Incident
    a owl:Class ;
    rdfs:label "Incident" ;
    rdfs:comment "Occupational incident or accident associated with a risk." .


rg:Process
    a owl:Class ;
    rdfs:label "Process" ;
    rdfs:comment "Organizational process in which risks may occur." .


rg:Area
    a owl:Class ;
    rdfs:label "Area" ;
    rdfs:comment "Organizational or operational area associated with a risk." .


rg:Location
    a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "Physical location associated with risks or incidents." .


# ============================================================
# OBJECT PROPERTIES
# ============================================================

rg:hasCause
    a owl:ObjectProperty ;
    rdfs:label "has cause" ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Cause .


rg:hasControl
    a owl:ObjectProperty ;
    rdfs:label "has control" ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Control .


rg:hasIncident
    a owl:ObjectProperty ;
    rdfs:label "has incident" ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Incident .


rg:belongsToProcess
    a owl:ObjectProperty ;
    rdfs:label "belongs to process" ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Process .


rg:belongsToArea
    a owl:ObjectProperty ;
    rdfs:label "belongs to area" ;
    rdfs:domain rg:Risk ;
    rdfs:range rg:Area .


rg:locatedIn
    a owl:ObjectProperty ;
    rdfs:label "located in" ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            rg:Risk
            rg:Incident
        )
    ] ;
    rdfs:range rg:Location .


# ============================================================
# DATATYPE PROPERTIES - GENERAL
# ============================================================

rg:code
    a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:range xsd:string .


rg:name
    a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string .


rg:description
    a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string .


rg:status
    a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:range xsd:string .


# ============================================================
# DATATYPE PROPERTIES - RISK
# ============================================================

rg:category
    a owl:DatatypeProperty ;
    rdfs:label "category" ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:string .


rg:probability
    a owl:DatatypeProperty ;
    rdfs:label "probability" ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:integer .


rg:impact
    a owl:DatatypeProperty ;
    rdfs:label "impact" ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:integer .


rg:riskScore
    a owl:DatatypeProperty ;
    rdfs:label "risk score" ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:integer .


rg:riskLevel
    a owl:DatatypeProperty ;
    rdfs:label "risk level" ;
    rdfs:domain rg:Risk ;
    rdfs:range xsd:string .


# ============================================================
# DATATYPE PROPERTIES - CAUSE
# ============================================================

rg:causeType
    a owl:DatatypeProperty ;
    rdfs:label "cause type" ;
    rdfs:domain rg:Cause ;
    rdfs:range xsd:string .


# ============================================================
# DATATYPE PROPERTIES - CONTROL
# ============================================================

rg:controlType
    a owl:DatatypeProperty ;
    rdfs:label "control type" ;
    rdfs:domain rg:Control ;
    rdfs:range xsd:string .


rg:hierarchyLevel
    a owl:DatatypeProperty ;
    rdfs:label "hierarchy level" ;
    rdfs:domain rg:Control ;
    rdfs:range xsd:string .


rg:effectiveness
    a owl:DatatypeProperty ;
    rdfs:label "effectiveness" ;
    rdfs:domain rg:Control ;
    rdfs:range xsd:double .


# ============================================================
# DATATYPE PROPERTIES - INCIDENT
# ============================================================

rg:title
    a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain rg:Incident ;
    rdfs:range xsd:string .


rg:incidentDate
    a owl:DatatypeProperty ;
    rdfs:label "incident date" ;
    rdfs:domain rg:Incident ;
    rdfs:range xsd:date .


rg:incidentType
    a owl:DatatypeProperty ;
    rdfs:label "incident type" ;
    rdfs:domain rg:Incident ;
    rdfs:range xsd:string .


rg:severity
    a owl:DatatypeProperty ;
    rdfs:label "severity" ;
    rdfs:domain rg:Incident ;
    rdfs:range xsd:string .


# ============================================================
# PROPERTY CHARACTERISTICS
# ============================================================

rg:hasCause
    rdfs:subPropertyOf rg:hasCause .

rg:hasControl
    rdfs:subPropertyOf rg:hasControl .

rg:hasIncident
    rdfs:subPropertyOf rg:hasIncident .

rg:belongsToProcess
    rdfs:subPropertyOf rg:belongsToProcess .

rg:belongsToArea
    rdfs:subPropertyOf rg:belongsToArea .

rg:locatedIn
    rdfs:subPropertyOf rg:locatedIn .


# ============================================================
# BASIC CLASS RESTRICTIONS
# ============================================================

rg:Risk
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty rg:probability ;
            owl:allValuesFrom xsd:integer
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty rg:impact ;
            owl:allValuesFrom xsd:integer
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty rg:riskScore ;
            owl:allValuesFrom xsd:integer
        ] .


rg:Control
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty rg:effectiveness ;
            owl:allValuesFrom xsd:double
        ] .


rg:Incident
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:onProperty rg:incidentDate ;
            owl:allValuesFrom xsd:date
        ] .
