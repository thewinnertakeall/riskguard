export async function getEvidence(params = {}) {
  const query = new URLSearchParams();

  if (params.status) {
    query.set("status", params.status);
  }

  if (params.risk_id !== undefined && params.risk_id !== null) {
    query.set("risk_id", params.risk_id);
  }

  if (
    params.iso_control_id !== undefined &&
    params.iso_control_id !== null
  ) {
    query.set("iso_control_id", params.iso_control_id);
  }

  const queryString = query.toString();

  return request(
    `/api/v2/evidence${queryString ? `?${queryString}` : ""}`
  );
}

