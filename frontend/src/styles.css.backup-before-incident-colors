:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #172033;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: #f5f7fb;
}

button {
  font: inherit;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.app-shell {
  min-height: 100vh;
  display: flex;
}

/* Sidebar */

.sidebar {
  width: 260px;
  min-height: 100vh;
  padding: 26px 18px;
  background: #111827;
  color: white;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 10px 28px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: #2563eb;
  font-size: 22px;
  font-weight: 800;
}

.brand-name {
  font-size: 18px;
  font-weight: 800;
}

.brand-subtitle {
  margin-top: 2px;
  font-size: 11px;
  color: #9ca3af;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  border: 0;
  border-radius: 9px;
  padding: 12px 13px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #cbd5e1;
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.nav-item:hover {
  background: #1f2937;
  color: white;
}

.nav-item.active {
  background: #1d4ed8;
  color: white;
}

.nav-item span {
  width: 18px;
  text-align: center;
}

.architecture-box {
  margin-top: auto;
  padding: 15px;
  border: 1px solid #374151;
  border-radius: 12px;
  background: #172033;
}

.architecture-title {
  margin-bottom: 10px;
  font-size: 11px;
  font-weight: 700;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.architecture-flow {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 6px;
  font-size: 10px;
  color: #d1d5db;
}

.architecture-flow b {
  color: #60a5fa;
}

/* Main */

.main-content {
  flex: 1;
  min-width: 0;
  padding: 30px 34px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 28px;
}

.eyebrow {
  margin-bottom: 7px;
  color: #2563eb;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.topbar h1 {
  margin: 0;
  font-size: 30px;
  letter-spacing: -0.04em;
}

.topbar p {
  margin: 7px 0 0;
  color: #64748b;
  font-size: 14px;
}

.topbar-actions {
  display: flex;
  gap: 10px;
}

.primary-button,
.secondary-button,
.analyze-button {
  border: 0;
  border-radius: 8px;
  padding: 10px 14px;
  font-weight: 700;
  cursor: pointer;
}

.primary-button {
  background: #2563eb;
  color: white;
}

.primary-button:hover {
  background: #1d4ed8;
}

.secondary-button {
  border: 1px solid #dbe2ea;
  background: white;
  color: #334155;
}

.secondary-button:hover {
  background: #f8fafc;
}

.full-width {
  width: 100%;
}

.error-banner {
  margin-bottom: 18px;
  padding: 13px 15px;
  border: 1px solid #fecaca;
  border-radius: 9px;
  background: #fef2f2;
  color: #991b1b;
  font-size: 13px;
}

/* Statistics */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-bottom: 20px;
}

.stat-card {
  min-height: 112px;
  padding: 19px;
  display: flex;
  align-items: center;
  gap: 15px;
  border: 1px solid #e5eaf1;
  border-radius: 13px;
  background: white;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.035);
}

.stat-icon {
  width: 45px;
  height: 45px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: #eff6ff;
  color: #2563eb;
  font-weight: 800;
}

.stat-card.critical .stat-icon {
  background: #fef2f2;
  color: #dc2626;
}

.stat-card.high .stat-icon {
  background: #fff7ed;
  color: #ea580c;
}

.stat-card.incident .stat-icon {
  background: #fefce8;
  color: #ca8a04;
}

.stat-content {
  display: flex;
  flex-direction: column;
}

.stat-content span {
  color: #64748b;
  font-size: 12px;
}

.stat-content strong {
  margin-top: 2px;
  font-size: 27px;
  letter-spacing: -0.03em;
}

.stat-content small {
  margin-top: 3px;
  color: #94a3b8;
  font-size: 10px;
}

/* Panels */

.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(330px, 0.85fr);
  gap: 20px;
}

.bottom-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.85fr);
  gap: 20px;
  margin-top: 20px;
}

.panel {
  border: 1px solid #e5eaf1;
  border-radius: 13px;
  background: white;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.035);
  overflow: hidden;
}

.panel-header {
  padding: 18px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  border-bottom: 1px solid #edf0f4;
}

.panel-header h2 {
  margin: 0;
  font-size: 15px;
}

.panel-header p {
  margin: 4px 0 0;
  color: #94a3b8;
  font-size: 11px;
}

.count-badge {
  padding: 5px 9px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
}

/* Risk table */

.risk-table-wrapper {
  overflow-x: auto;
}

.risk-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 760px;
}

.risk-table th {
  padding: 11px 13px;
  background: #f8fafc;
  color: #64748b;
  font-size: 10px;
  text-align: left;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.risk-table td {
  padding: 13px;
  border-top: 1px solid #edf0f4;
  font-size: 12px;
  vertical-align: middle;
}

.risk-table tbody tr:hover {
  background: #fafcff;
}

.risk-table tbody tr.selected-row {
  background: #eff6ff;
}

.risk-name {
  font-weight: 700;
  color: #1e293b;
}

.risk-description {
  max-width: 250px;
  margin-top: 3px;
  overflow: hidden;
  color: #94a3b8;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.risk-badge {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
}

.risk-badge.critical {
  background: #fee2e2;
  color: #b91c1c;
}

.risk-badge.high {
  background: #ffedd5;
  color: #c2410c;
}

.risk-badge.medium {
  background: #fef3c7;
  color: #a16207;
}

.risk-badge.low {
  background: #dcfce7;
  color: #15803d;
}

.risk-badge.unknown {
  background: #e2e8f0;
  color: #475569;
}

.status-dot {
  color: #64748b;
  font-size: 10px;
}

.analyze-button {
  padding: 6px 9px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 10px;
}

.analyze-button:hover {
  background: #dbeafe;
}

/* Selected risk */

.selected-risk {
  padding: 20px;
}

.selected-risk-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 15px;
}

.risk-code {
  color: #2563eb;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.selected-risk-header h3 {
  max-width: 300px;
  margin: 6px 0 0;
  font-size: 18px;
  line-height: 1.25;
}

.score-display {
  min-width: 72px;
  text-align: right;
}

.score-display span {
  display: block;
  color: #94a3b8;
  font-size: 9px;
}

.score-display strong {
  font-size: 30px;
}

.score-display small {
  color: #94a3b8;
}

.risk-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin: 20px 0;
}

.metric {
  padding: 10px;
  border-radius: 8px;
  background: #f8fafc;
}

.metric span {
  display: block;
  color: #94a3b8;
  font-size: 9px;
}

.metric strong {
  display: block;
  margin-top: 3px;
  font-size: 12px;
}

/* Agents */

.agent-results {
  margin-top: 20px;
  padding-top: 17px;
  border-top: 1px solid #edf0f4;
}

.agent-title {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 10px;
  color: #334155;
  font-size: 11px;
  font-weight: 800;
}

.agent-pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #2563eb;
}

.agent-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.agent-card {
  padding: 10px;
  border: 1px solid #e8edf3;
  border-radius: 8px;
}

.agent-card span {
  display: block;
  color: #94a3b8;
  font-size: 8px;
}

.agent-card strong {
  display: block;
  margin-top: 4px;
  color: #334155;
  font-size: 10px;
}

.recommendations {
  margin-top: 12px;
  padding: 12px;
  border-radius: 9px;
  background: #f8fafc;
}

.recommendation-title {
  font-size: 10px;
  font-weight: 800;
}

.recommendations ol {
  margin: 7px 0 0;
  padding-left: 20px;
  color: #64748b;
  font-size: 10px;
  line-height: 1.6;
}

/* Semantic */

.semantic-content {
  padding: 20px;
}

.semantic-stat {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 11px 0;
  border-bottom: 1px solid #edf0f4;
}

.semantic-label {
  color: #64748b;
  font-size: 11px;
}

.semantic-stat strong {
  max-width: 70%;
  overflow: hidden;
  color: #334155;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.semantic-actions {
  margin-top: 15px;
}

.connection-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
}

.connection-status.online {
  color: #15803d;
}

.status-circle {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
}

.status-circle.offline {
  background: #ef4444;
}

/* System */

.system-list {
  padding: 8px 20px 15px;
}

.system-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 11px 0;
  border-bottom: 1px solid #edf0f4;
}

.system-item:last-child {
  border-bottom: 0;
}

.system-name {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #334155;
  font-size: 11px;
}

.system-status {
  color: #94a3b8;
  font-size: 9px;
}

.system-status.operational {
  color: #15803d;
  font-weight: 700;
}

/* States */

.loading-state,
.empty-state {
  min-height: 180px;
  display: grid;
  place-items: center;
  color: #94a3b8;
  font-size: 12px;
}

/* Footer */

.footer {
  margin-top: 25px;
  padding: 16px 4px 5px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: #94a3b8;
  font-size: 10px;
}

/* Responsive */

@media (max-width: 1180px) {

  .sidebar {
    width: 220px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .content-grid,
  .bottom-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {

  .app-shell {
    display: block;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
    padding: 15px;
  }

  .navigation {
    flex-direction: row;
    overflow-x: auto;
  }

  .nav-item {
    white-space: nowrap;
  }

  .architecture-box {
    display: none;
  }

  .main-content {
    padding: 20px 15px;
  }

  .topbar {
    flex-direction: column;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .footer {
    flex-direction: column;
  }
}

/* =========================================================
   RISK REGISTER CRUD
   ========================================================= */

.risk-register-header {
  align-items: center;
}

.risk-register-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.primary-button,
.secondary-button,
.danger-button {
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 9px 13px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s ease;
}

.primary-button {
  background: #2563eb;
  color: white;
}

.primary-button:hover {
  filter: brightness(1.08);
}

.secondary-button {
  background: #172033;
  color: #dbeafe;
  border-color: #334155;
}

.secondary-button:hover {
  background: #1e293b;
}

.danger-button {
  background: #3a1518;
  color: #fecaca;
  border-color: #7f1d1d;
}

.danger-button:hover {
  background: #571b20;
}

.primary-button:disabled,
.secondary-button:disabled,
.danger-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.small-button {
  padding: 6px 9px;
  font-size: 11px;
}

.risk-filters {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) 160px 160px;
  gap: 10px;
  padding: 0 20px 18px;
}

.risk-filters input,
.risk-filters select {
  width: 100%;
  box-sizing: border-box;
  background: #0f172a;
  border: 1px solid #334155;
  color: #e2e8f0;
  border-radius: 8px;
  padding: 9px 11px;
  font-size: 12px;
  outline: none;
}

.risk-filters input:focus,
.risk-filters select:focus {
  border-color: #3b82f6;
}

.risk-actions {
  display: flex;
  align-items: center;
  gap: 5px;
  flex-wrap: wrap;
}

/* Modal */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(2, 6, 23, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.risk-modal {
  width: min(850px, 100%);
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 14px;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.45);
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 22px;
  border-bottom: 1px solid #1e293b;
}

.modal-header h2 {
  margin: 0;
  font-size: 18px;
  color: #f8fafc;
}

.modal-header p {
  margin: 5px 0 0;
  color: #94a3b8;
  font-size: 12px;
}

.modal-close {
  border: 0;
  background: transparent;
  color: #94a3b8;
  font-size: 25px;
  line-height: 1;
  cursor: pointer;
}

.modal-close:hover {
  color: #f8fafc;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  padding: 22px;
}

.form-grid label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: #cbd5e1;
  font-size: 11px;
  font-weight: 700;
}

.form-grid input,
.form-grid textarea,
.form-grid select {
  width: 100%;
  box-sizing: border-box;
  background: #020617;
  border: 1px solid #334155;
  border-radius: 8px;
  color: #e2e8f0;
  padding: 9px 10px;
  font: inherit;
  font-weight: 400;
  outline: none;
}

.form-grid textarea {
  resize: vertical;
}

.form-grid input:focus,
.form-grid textarea:focus,
.form-grid select:focus {
  border-color: #3b82f6;
}

.form-full {
  grid-column: 1 / -1;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 16px 22px 20px;
  border-top: 1px solid #1e293b;
}

@media (max-width: 800px) {
  .risk-register-header {
    align-items: flex-start;
  }

  .risk-register-actions {
    width: 100%;
  }

  .risk-filters {
    grid-template-columns: 1fr;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .form-full {
    grid-column: auto;
  }

  .risk-actions {
    flex-direction: column;
    align-items: stretch;
  }
}

/* =========================================================
   ISO 27001 - Risk ↔ ISO Controls
   ========================================================= */

.linked-controls {
  padding: 20px;
  border-bottom: 1px solid #e5eaf1;
}

.linked-controls h3,
.link-control-form h3 {
  margin: 0 0 14px;
  font-size: 14px;
  color: #0f172a;
}

.linked-control {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 14px;
  margin-bottom: 10px;
  border: 1px solid #e5eaf1;
  border-radius: 10px;
  background: #f8fafc;
}

.linked-control:last-child {
  margin-bottom: 0;
}

.linked-control strong {
  display: block;
  margin-bottom: 5px;
  font-size: 13px;
  color: #2563eb;
}

.linked-control small {
  display: block;
  margin-top: 8px;
  color: #64748b;
  font-size: 11px;
}

.link-control-form {
  padding: 20px;
  background: #ffffff;
}

.link-control-form .form-group {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 14px;
}

.link-control-form label {
  font-size: 11px;
  font-weight: 700;
  color: #475569;
}

.link-control-form select,
.link-control-form textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #0f172a;
  font: inherit;
  font-size: 12px;
  outline: none;
}

.link-control-form select {
  min-height: 40px;
}

.link-control-form textarea {
  min-height: 80px;
  resize: vertical;
}

.link-control-form select:focus,
.link-control-form textarea:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.10);
}

.link-control-form .primary-button {
  margin-top: 4px;
}

.link-control-form .primary-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* Responsive */
@media (max-width: 700px) {
  .linked-control {
    flex-direction: column;
  }

  .linked-control .secondary-button {
    width: 100%;
  }
}


/* Incident status */
.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.status-open {
  background: rgba(245, 158, 11, 0.15);
  color: #fbbf24;
}

.status-closed {
  background: rgba(34, 197, 94, 0.15);
  color: #4ade80;
}

