import { useEffect, useMemo, useState } from "react";

import DashboardView from "./views/DashboardView";
import RiskRegisterView from "./views/RiskRegisterView";
import IncidentsView from "./views/IncidentsView";
import ControlsView from "./views/ControlsView";
import ISO27001View from "./views/ISO27001View";
import KnowledgeView from "./views/KnowledgeView";

import {
  analyzeRisk,
  getIncidents,
  getRisks,
  getSemanticStatus,
  synchronizeSemanticGraph,
  getISO27001Status,
  getISO27001Controls,
  getISO27001Compliance,
  getISO27001SoA,
  updateISO27001Control,
  getRiskISOControls,
  createRiskISOControl,
  deleteRiskISOControl
} from "./api";

function App() {
  const [activeSection, setActiveSection] = useState("dashboard");

  const [risks, setRisks] = useState([]);
  const [incidents, setIncidents] = useState([]);
  const [semantic, setSemantic] = useState(null);

  const [isoStatus, setIsoStatus] = useState(null);
  const [isoControls, setIsoControls] = useState([]);
  const [isoCompliance, setIsoCompliance] = useState(null);
  const [isoSoA, setIsoSoA] = useState(null);
  const [isoLoading, setIsoLoading] = useState(false);
  const [isoSaving, setIsoSaving] = useState(null);

  const [riskISOControls, setRiskISOControls] = useState([]);
  const [riskISOLoading, setRiskISOLoading] = useState(false);
  const [riskISOSaving, setRiskISOSaving] = useState(false);

  const [selectedRisk, setSelectedRisk] = useState(null);
  const [analysis, setAnalysis] = useState(null);

  const [loading, setLoading] = useState(true);
  const [analysisLoading, setAnalysisLoading] = useState(false);
  const [syncLoading, setSyncLoading] = useState(false);

  const [error, setError] = useState("");

  async function loadDashboard() {
    try {
      setLoading(true);
      setError("");

      const [riskData, incidentData, semanticData] = await Promise.all([
        getRisks(),
        getIncidents(),
        getSemanticStatus()
      ]);

      const safeRisks = Array.isArray(riskData) ? riskData : [];
      const safeIncidents = Array.isArray(incidentData)
        ? incidentData
        : [];

      setRisks(safeRisks);
      setIncidents(safeIncidents);
      setSemantic(semanticData);

      if (!selectedRisk && safeRisks.length > 0) {
        setSelectedRisk(safeRisks[0]);
      }
    } catch (err) {
      console.error(err);
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  async function loadISO27001() {
    try {
      setIsoLoading(true);

      const [
        statusData,
        controlsData,
        complianceData,
        soaData
      ] = await Promise.all([
        getISO27001Status(),
        getISO27001Controls(),
        getISO27001Compliance(),
        getISO27001SoA()
      ]);

      setIsoStatus(statusData);
      setIsoControls(
        Array.isArray(controlsData)
          ? controlsData
          : []
      );
      setIsoCompliance(complianceData);
      setIsoSoA(soaData);

    } catch (err) {
      console.error(err);
      setError(err.message);
    } finally {
      setIsoLoading(false);
    }
  }

  async function saveISOControl(code, data) {
    try {
      setIsoSaving(code);
      setError("");

      await updateISO27001Control(code, data);

      await loadISO27001();
    } catch (err) {
      console.error(err);
      setError(err.message);
    } finally {
      setIsoSaving(null);
    }
  }

  async function handleAnalyze(risk) {
    try {
      setSelectedRisk(risk);
      setAnalysisLoading(true);
      setError("");

      const result = await analyzeRisk(risk.code);

      setAnalysis(result);
      setActiveSection("multiagent");
    } catch (err) {
      console.error(err);
      setError(err.message);
      setAnalysis(null);
    } finally {
      setAnalysisLoading(false);
    }
  }

  async function handleSemanticSync() {
    try {
      setSyncLoading(true);
      setError("");

      await synchronizeSemanticGraph();

      const status = await getSemanticStatus();

      setSemantic(status);
    } catch (err) {
      console.error(err);
      setError(err.message);
    } finally {
      setSyncLoading(false);
    }
  }

  async function loadRiskISOControls(risk) {
    try {
      setRiskISOLoading(true);
      setError("");

      const data = await getRiskISOControls(risk.code);

      setRiskISOControls(
        Array.isArray(data?.iso_controls)
          ? data.iso_controls
          : []
      );
    } catch (err) {
      console.error(err);
      setError(err.message);
      setRiskISOControls([]);
    } finally {
      setRiskISOLoading(false);
    }
  }

  async function handleCreateRiskISOControl(data) {
    if (!selectedRisk?.code) {
      setError("Debe seleccionar un riesgo.");
      return;
    }

    try {
      setRiskISOSaving(true);
      setError("");

      await createRiskISOControl(
        selectedRisk.code,
        data
      );

      await loadRiskISOControls(selectedRisk);
    } catch (err) {
      console.error(err);
      setError(err.message);
    } finally {
      setRiskISOSaving(false);
    }
  }

  async function handleDeleteRiskISOControl(isoControlCode) {
    if (!selectedRisk?.code) {
      setError("Debe seleccionar un riesgo.");
      return;
    }

    try {
      setRiskISOSaving(true);
      setError("");

      await deleteRiskISOControl(
        selectedRisk.code,
        isoControlCode
      );

      await loadRiskISOControls(selectedRisk);
    } catch (err) {
      console.error(err);
      setError(err.message);
    } finally {
      setRiskISOSaving(false);
    }
  }

  useEffect(() => {
    loadDashboard();
    loadISO27001();
  }, []);
  
  useEffect(() => {
    if (selectedRisk?.code) {
      loadRiskISOControls(selectedRisk);
    }
  }, [selectedRisk?.code]);


  const statistics = useMemo(() => {
    const total = risks.length;

    const critical = risks.filter(
      (risk) => risk.risk_level === "Critical"
    ).length;

    const high = risks.filter(
      (risk) => risk.risk_level === "High"
    ).length;

    const medium = risks.filter(
      (risk) => risk.risk_level === "Medium"
    ).length;

    const low = risks.filter(
      (risk) => risk.risk_level === "Low"
    ).length;

    const openIncidents = incidents.filter(
      (incident) =>
        String(incident.status || "").toLowerCase() === "open"
    ).length;

    return {
      total,
      critical,
      high,
      medium,
      low,
      incidents: incidents.length,
      openIncidents
    };
  }, [risks, incidents]);

  const navigation = [
    { id: "dashboard", icon: "▦", label: "Dashboard" },
    { id: "risks", icon: "⚠", label: "Risk Register" },
    { id: "incidents", icon: "◉", label: "Incidents" },
    { id: "controls", icon: "◆", label: "Controls" },
    { id: "iso27001", icon: "✓", label: "ISO 27001" },
    { id: "knowledge", icon: "◈", label: "Knowledge Graph" },
    { id: "multiagent", icon: "◎", label: "Multi-Agent" }
  ];

  return (
    <div className="app-shell">

      <aside className="sidebar">

        <div className="brand">
          <div className="brand-mark">R</div>

          <div>
            <div className="brand-name">RiskGuard</div>
            <div className="brand-subtitle">
              Safety Intelligence
            </div>
          </div>
        </div>

        <nav className="navigation">

          {navigation.map((item) => (
            <button
              key={item.id}
              className={`nav-item ${
                activeSection === item.id ? "active" : ""
              }`}
              onClick={() => setActiveSection(item.id)}
            >
              <span>{item.icon}</span>
              {item.label}
            </button>
          ))}

        </nav>

        <div className="architecture-box">

          <div className="architecture-title">
            Intelligent Architecture
          </div>

          <div className="architecture-flow">
            <span>SQL</span>
            <b>→</b>
            <span>RDF</span>
            <b>→</b>
            <span>OWL</span>
          </div>

          <div className="architecture-flow">
            <span>SPARQL</span>
            <b>→</b>
            <span>Agents</span>
          </div>

        </div>

      </aside>

      <main className="main-content">

        <header className="topbar">

          <div>
            <div className="eyebrow">
              OCCUPATIONAL RISK MANAGEMENT
            </div>

            <h1>
              {activeSection === "dashboard" &&
                "Risk Intelligence Dashboard"}

              {activeSection === "risks" &&
                "Risk Register"}

              {activeSection === "incidents" &&
                "Incident Management"}

              {activeSection === "controls" &&
                "Risk Controls"}

              {activeSection === "iso27001" &&
                "ISO/IEC 27001:2022"}

              {activeSection === "knowledge" &&
                "Knowledge Graph"}

              {activeSection === "multiagent" &&
                "Multi-Agent Intelligence"}
            </h1>

            <p>
              Semantic and multi-agent analysis of occupational risks.
            </p>
          </div>

          <div className="topbar-actions">

            <button
              className="secondary-button"
              onClick={loadDashboard}
              disabled={loading}
            >
              ↻ Refresh
            </button>

          </div>

        </header>

        {error && (
          <div className="error-banner">
            <strong>Connection error:</strong> {error}
          </div>
        )}

        {activeSection === "dashboard" && (
          <DashboardView
            risks={risks}
            incidents={incidents}
            semantic={semantic}
            statistics={statistics}
            selectedRisk={selectedRisk}
            analysis={analysis}
            loading={loading}
            analysisLoading={analysisLoading}
            syncLoading={syncLoading}
            handleAnalyze={handleAnalyze}
            handleSemanticSync={handleSemanticSync}
          />
        )}

        {activeSection === "risks" && (
          <RiskRegisterView
            risks={risks}
            loading={loading}
            selectedRisk={selectedRisk}
            handleAnalyze={handleAnalyze}
            statistics={statistics}
          />
        )}

        {activeSection === "incidents" && (
          <IncidentsView
            incidents={incidents}
            statistics={statistics}
          />
        )}

        {activeSection === "controls" && (
          <ControlsView
            risks={risks}
            selectedRisk={selectedRisk}
            analysis={analysis}
            handleAnalyze={handleAnalyze}
            analysisLoading={analysisLoading}
          />
        )}

        {activeSection === "iso27001" && (
          <ISO27001View
            risks={risks}
            selectedRisk={selectedRisk}
            setSelectedRisk={setSelectedRisk}
            isoStatus={isoStatus}
            isoControls={isoControls}
            isoCompliance={isoCompliance}
            isoSoA={isoSoA}
            isoLoading={isoLoading}
            isoSaving={isoSaving}
            saveISOControl={saveISOControl}
            riskISOControls={riskISOControls}
            riskISOLoading={riskISOLoading}
            riskISOSaving={riskISOSaving}
            handleCreateRiskISOControl={handleCreateRiskISOControl}
            handleDeleteRiskISOControl={handleDeleteRiskISOControl}
          />
        )}

        {activeSection === "knowledge" && (
          <KnowledgeView
            semantic={semantic}
            syncLoading={syncLoading}
            handleSemanticSync={handleSemanticSync}
          />
        )}

        {activeSection === "multiagent" && (
          <MultiAgentView
            risks={risks}
            selectedRisk={selectedRisk}
            setSelectedRisk={setSelectedRisk}
            analysis={analysis}
            handleAnalyze={handleAnalyze}
            analysisLoading={analysisLoading}
          />
        )}

        <footer className="footer">

          <span>
            RiskGuard v1.1.0
          </span>

          <span>
            SQL · RDF · OWL · SPARQL · Reasoning · Multi-Agent
          </span>

        </footer>

      </main>

    </div>
  );
}


/* =========================================================
   DASHBOARD
========================================================= */

function MultiAgentView({
  risks,
  selectedRisk,
  setSelectedRisk,
  analysis,
  handleAnalyze,
  analysisLoading
}) {
  return (
    <>
      <section className="stats-grid">

        <StatCard
          title="Risk Agent"
          value="READY"
          icon="◈"
          description="Risk analysis"
        />

        <StatCard
          title="Control Agent"
          value="READY"
          icon="◆"
          description="Control analysis"
        />

        <StatCard
          title="Incident Agent"
          value="READY"
          icon="●"
          description="Incident analysis"
        />

        <StatCard
          title="Coordinator"
          value="READY"
          icon="◎"
          description="Decision coordination"
        />

      </section>

      <div className="panel">

        <div className="panel-header">

          <div>
            <h2>Multi-Agent Intelligence</h2>
            <p>
              Select a risk and execute the CoordinatorAgent.
            </p>
          </div>

        </div>

        {risks.length === 0 ? (

          <div className="empty-state">
            No risks available for analysis.
          </div>

        ) : (

          <>
            <div className="risk-table-wrapper">

              <table className="risk-table">

                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Risk</th>
                    <th>Score</th>
                    <th>Level</th>
                    <th></th>
                  </tr>
                </thead>

                <tbody>

                  {risks.map((risk) => (

                    <tr
                      key={risk.id || risk.code}
                      className={
                        selectedRisk?.code === risk.code
                          ? "selected-row"
                          : ""
                      }
                    >

                      <td>
                        <strong>{risk.code}</strong>
                      </td>

                      <td>
                        {risk.name}
                      </td>

                      <td>
                        {risk.risk_score}
                      </td>

                      <td>
                        <RiskBadge level={risk.risk_level} />
                      </td>

                      <td>

                        <button
                          className="analyze-button"
                          onClick={() => {
                            setSelectedRisk(risk);
                            handleAnalyze(risk);
                          }}
                          disabled={analysisLoading}
                        >
                          Analyze
                        </button>

                      </td>

                    </tr>

                  ))}

                </tbody>

              </table>

            </div>

            {selectedRisk && (

              <div className="selected-risk">

                <div className="selected-risk-header">

                  <div>

                    <span className="risk-code">
                      {selectedRisk.code}
                    </span>

                    <h3>
                      {selectedRisk.name}
                    </h3>

                  </div>

                  <div className="score-display">

                    <span>Risk Score</span>

                    <strong>
                      {selectedRisk.risk_score}
                    </strong>

                    <small>/ 25</small>

                  </div>

                </div>

                <button
                  className="primary-button full-width"
                  onClick={() => handleAnalyze(selectedRisk)}
                  disabled={analysisLoading}
                >
                  {analysisLoading
                    ? "Running agents..."
                    : "Run CoordinatorAgent"}
                </button>

                {analysis && (
                  <AgentResults analysis={analysis} />
                )}

              </div>

            )}

          </>
        )}

      </div>
    </>
  );
}


/* =========================================================
   REUSABLE COMPONENTS
========================================================= */

function RiskTable({
  risks,
  loading,
  selectedRisk,
  handleAnalyze
}) {
  if (loading) {
    return (
      <div className="loading-state">
        Loading risks...
      </div>
    );
  }

  if (risks.length === 0) {
    return (
      <div className="empty-state">
        No risks registered.
      </div>
    );
  }

  return (
    <div className="risk-table-wrapper">

      <table className="risk-table">

        <thead>
          <tr>
            <th>Code</th>
            <th>Risk</th>
            <th>Category</th>
            <th>Score</th>
            <th>Level</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>

        <tbody>

          {risks.map((risk) => (

            <tr
              key={risk.id || risk.code}
              className={
                selectedRisk?.code === risk.code
                  ? "selected-row"
                  : ""
              }
            >

              <td>
                <strong>{risk.code}</strong>
              </td>

              <td>
                <div className="risk-name">
                  {risk.name}
                </div>

                {risk.description && (
                  <div className="risk-description">
                    {risk.description}
                  </div>
                )}
              </td>

              <td>
                {risk.category || "—"}
              </td>

              <td>
                <strong>{risk.risk_score}</strong>
              </td>

              <td>
                <RiskBadge level={risk.risk_level} />
              </td>

              <td>
                <span className="status-dot">
                  {risk.status || "Unknown"}
                </span>
              </td>

              <td>

                <button
                  className="analyze-button"
                  onClick={() => handleAnalyze(risk)}
                >
                  Analyze
                </button>

              </td>

            </tr>

          ))}

        </tbody>

      </table>

    </div>
  );
}


function KnowledgeCard({
  semantic,
  syncLoading,
  handleSemanticSync
}) {
  return (
    <div className="panel semantic-panel">

      <div className="panel-header">

        <div>
          <h2>Knowledge Graph</h2>
          <p>RDF / OWL semantic layer</p>
        </div>

        <span
          className={
            semantic?.success
              ? "connection-status online"
              : "connection-status offline"
          }
        >
          <span className="status-circle"></span>
          {semantic?.success
            ? "Available"
            : "Unavailable"}
        </span>

      </div>

      <div className="semantic-content">

        <div className="semantic-stat">

          <span className="semantic-label">
            RDF file
          </span>

          <strong>
            {semantic?.rdf_file || "—"}
          </strong>

        </div>

        <div className="semantic-stat">

          <span className="semantic-label">
            Triples
          </span>

          <strong>
            {semantic?.triples ?? 0}
          </strong>

        </div>

        <div className="semantic-actions">

          <button
            className="primary-button"
            onClick={handleSemanticSync}
            disabled={syncLoading}
          >
            {syncLoading
              ? "Synchronizing..."
              : "Synchronize SQL → RDF"}
          </button>

        </div>

      </div>

    </div>
  );
}


function SystemStatusPanel({ semantic }) {
  return (
    <div className="panel architecture-panel">

      <div className="panel-header">

        <div>
          <h2>System Status</h2>
          <p>RiskGuard components</p>
        </div>

      </div>

      <div className="system-list">

        <SystemStatus
          name="FastAPI"
          status="Operational"
        />

        <SystemStatus
          name="SQLite"
          status="Operational"
        />

        <SystemStatus
          name="RDF / OWL"
          status={
            semantic?.success
              ? "Operational"
              : "Unavailable"
          }
        />

        <SystemStatus
          name="Multi-Agent System"
          status="Operational"
        />

        <SystemStatus
          name="SPARQL"
          status="Operational"
        />

      </div>

    </div>
  );
}


function StatCard({
  title,
  value,
  icon,
  description,
  variant = ""
}) {
  return (
    <div className={`stat-card ${variant}`}>

      <div className="stat-icon">
        {icon}
      </div>

      <div className="stat-content">

        <span>{title}</span>

        <strong>{value}</strong>

        <small>{description}</small>

      </div>

    </div>
  );
}


function RiskBadge({ level }) {
  const normalized = String(level || "Unknown").toLowerCase();

  return (
    <span className={`risk-badge ${normalized}`}>
      {level || "Unknown"}
    </span>
  );
}


function Metric({ label, value }) {
  return (
    <div className="metric">

      <span>{label}</span>

      <strong>{value}</strong>

    </div>
  );
}


function AgentResults({ analysis }) {
  const riskAnalysis = analysis?.risk_analysis || {};
  const controlAnalysis = analysis?.control_analysis || {};
  const incidentAnalysis = analysis?.incident_analysis || {};
  const recommendation = analysis?.recommendation || {};

  const risk = riskAnalysis.risk || {};

  return (
    <div className="agent-results">

      <div className="agent-title">
        <span className="agent-pulse"></span>
        Multi-Agent Analysis
      </div>

      <div className="agent-grid">

        <AgentCard
          name="Risk Analysis Agent"
          value={
            risk.risk_level ||
            riskAnalysis.risk_level ||
            riskAnalysis.level ||
            "Analyzed"
          }
        />

        <AgentCard
          name="Control Analysis Agent"
          value={
            controlAnalysis.control_status ||
            "Analyzed"
          }
        />

        <AgentCard
          name="Incident Analysis Agent"
          value={
            incidentAnalysis.incident_status ||
            "Analyzed"
          }
        />

        <AgentCard
          name="Recommendation Agent"
          value={
            recommendation.priority ||
            "Generated"
          }
        />

      </div>

      {recommendation.summary && (
        <div className="recommendation-box">

          <strong>Recommendation</strong>

          <p>
            {recommendation.summary}
          </p>

          {Array.isArray(recommendation.recommendations) && (
            <ul>
              {recommendation.recommendations.map(
                (item, index) => (
                  <li key={index}>{item}</li>
                )
              )}
            </ul>
          )}

        </div>
      )}

    </div>
  );
}


function AgentCard({ name, value }) {
  return (
    <div className="agent-card">

      <span className="agent-card-name">
        {name}
      </span>

      <strong>
        {value}
      </strong>

    </div>
  );
}


function SystemStatus({ name, status }) {
  return (
    <div className="system-item">

      <span className="system-name">
        {name}
      </span>

      <span className="system-status">
        <span className="status-circle"></span>
        {status}
      </span>

    </div>
  );
}

export default App;
