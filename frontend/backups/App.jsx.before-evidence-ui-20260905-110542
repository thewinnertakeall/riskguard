                        }
                      />
                    </td>

                    <td>
                      {incident.status || "—"}
                    </td>

                    <td>
                      {incident.date ||
                        incident.incident_date ||
                        "—"}
                    </td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        )}

      </div>
    </>
