                  <tr key={incident.id || incident.code || index}>

                    <td>
                      <strong>
                        {incident.code || incident.incident_code || "—"}
                      </strong>
                    </td>

                    <td>
                      <div className="risk-name">
                        {incident.name ||
                          incident.description ||
                          "Incident"}
                      </div>
                    </td>

                    <td>
                      {incident.type || incident.incident_type || "—"}
                    </td>

                    <td>
                      <RiskBadge
