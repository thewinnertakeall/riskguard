}


/* =========================================================
   CONTROLS
========================================================= */

function ControlsView({
  risks,
  selectedRisk,
  analysis,
  handleAnalyze,
  analysisLoading
}) {
  const controls = [];

  risks.forEach((risk) => {
    const riskControls =
      risk.controls ||
      risk.risk_controls ||
      [];

    if (Array.isArray(riskControls)) {
      riskControls.forEach((control) => {
        controls.push({
          ...control,
          risk_code: risk.code
        });
      });
    }
  });

  const controlAnalysis = analysis?.control_analysis || {};

  return (
    <>
      <section className="stats-grid">

        <StatCard
          title="Risks"
          value={risks.length}
          icon="◈"
          description="With registered controls"
        />

        <StatCard
          title="Controls"
          value={controls.length || "—"}
          icon="◆"
          description="Available control records"
        />

        <StatCard
          title="Effectiveness"
          value={
            controlAnalysis.average_effectiveness != null
              ? `${controlAnalysis.average_effectiveness}%`
              : "—"
          }
          icon="✓"
          description="Latest analysis"
        />

        <StatCard
          title="Control Gap"
          value={
            controlAnalysis.control_gap
              ? "YES"
              : "—"
          }
          icon="!"
          variant={
            controlAnalysis.control_gap
              ? "critical"
              : ""
          }
          description="Multi-agent assessment"
        />

      </section>

      <div className="panel">

        <div className="panel-header">

          <div>
            <h2>Control Management</h2>
            <p>
              Controls used to reduce identified occupational risks.
            </p>
          </div>

        </div>

        {controls.length > 0 ? (

          <div className="risk-table-wrapper">

            <table className="risk-table">

              <thead>
                <tr>
                  <th>Risk</th>
                  <th>Control</th>
                  <th>Type</th>
                  <th>Hierarchy</th>
                  <th>Effectiveness</th>
                </tr>
              </thead>

              <tbody>

                {controls.map((control, index) => (

                  <tr key={control.id || index}>

                    <td>
                      <strong>{control.risk_code}</strong>
                    </td>

                    <td>
                      {control.name ||
                        control.description ||
                        "Control"}
                    </td>

                    <td>
                      {control.type || "—"}
                    </td>

                    <td>
                      {control.hierarchy ||
                        control.hierarchy_level ||
                        "—"}
                    </td>

                    <td>
                      {control.effectiveness != null
                        ? `${control.effectiveness}%`
                        : "—"}
                    </td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        ) : (

          <div className="control-analysis">

            <h3>Control intelligence</h3>

            <p>
              Select a risk and run the multi-agent analysis
              to inspect its controls and effectiveness.
            </p>

            {selectedRisk && (
              <button
                className="primary-button"
                onClick={() => handleAnalyze(selectedRisk)}
                disabled={analysisLoading}
              >
                {analysisLoading
                  ? "Analyzing..."
                  : `Analyze ${selectedRisk.code}`}
              </button>
            )}

            {controlAnalysis.control_status && (
              <AgentResults analysis={analysis} />
            )}

          </div>

        )}

      </div>
    </>
  );
}


/* =========================================================
   KNOWLEDGE GRAPH
========================================================= */

function ISO27001View({
  risks,
  selectedRisk,
  setSelectedRisk,
  isoStatus,
  isoControls,
  isoCompliance,
  isoSoA,
  isoLoading,
  isoSaving,
  saveISOControl,
  riskISOControls,
  riskISOLoading,
  riskISOSaving,
  handleCreateRiskISOControl,
  handleDeleteRiskISOControl
}) {
  const [selectedISOCode, setSelectedISOCode] = useState("");
  const [treatmentStatus, setTreatmentStatus] = useState("Planned");
  const [notes, setNotes] = useState("");

  const linkedCodes = new Set(
    riskISOControls.map((control) => control.code)
  );

  const availableControls = isoControls.filter(
    (control) => !linkedCodes.has(control.code)
  );

  function handleLink() {
    if (!selectedRisk?.code || !selectedISOCode) {
      return;
    }

    handleCreateRiskISOControl({
      iso_control_code: selectedISOCode,
      treatment_status: treatmentStatus,
      notes: notes.trim() || null
    });

    setSelectedISOCode("");
    setTreatmentStatus("Planned");
    setNotes("");
  }

  return (
    <section className="content-section">

      <div className="stats-grid">

        <StatCard
          title="ISO Controls"
          value={isoCompliance?.total_controls ?? isoControls.length}
          icon="✓"
          description="Controles gestionados"
        />

        <StatCard
          title="Implemented"
          value={isoCompliance?.implemented ?? 0}
          icon="●"
          description="Controles implementados"
          variant="success"
        />

        <StatCard
          title="Partial"
          value={isoCompliance?.partial ?? 0}
          icon="◐"
          description="Implementación parcial"
          variant="warning"
        />

        <StatCard
          title="Compliance"
          value={`${isoCompliance?.compliance_percentage ?? 0}%`}
          icon="%"
          description="Cumplimiento estimado"
        />

      </div>

      <div className="content-grid">

        <div className="panel">

          <div className="panel-header">

            <div>
              <h2>ISO/IEC 27001:2022</h2>
              <p>
                Gestión de controles de seguridad de la información
              </p>
            </div>

            <span className="connection-status online">
              <span className="status-circle"></span>
              {isoStatus?.standard || "ISO 27001"}
            </span>

          </div>

          {isoLoading ? (
            <div className="empty-state">
              Cargando controles ISO...
            </div>
          ) : (
            <div className="table-container">

              <table className="data-table">

                <thead>
                  <tr>
                    <th>Control</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Estado</th>
                    <th>Efectividad</th>
                    <th>Acción</th>
                  </tr>
                </thead>

                <tbody>

                  {isoControls.map((control) => (

                    <tr key={control.code}>

                      <td>
                        <strong>{control.code}</strong>
                      </td>

                      <td>
                        <div className="risk-name">
                          {control.name}
                        </div>

                        {control.description && (
                          <div className="risk-description">
                            {control.description}
                          </div>
                        )}
                      </td>

                      <td>
                        {control.category || "—"}
                      </td>

                      <td>
                        <span className="status-dot">
                          {control.implementation_status ||
                            "Not Implemented"}
                        </span>
                      </td>

                      <td>
                        {Number(control.effectiveness || 0)}%
                      </td>

                      <td>

                        <select
                          value={
                            control.implementation_status ||
                            "Not Implemented"
                          }
                          disabled={isoSaving === control.code}
                          onChange={(event) =>
                            saveISOControl(
                              control.code,
                              {
                                implementation_status:
                                  event.target.value,
                                effectiveness:
                                  control.effectiveness || 0
                              }
                            )
                          }
                        >
                          <option value="Not Implemented">
                            Not Implemented
                          </option>
                          <option value="Partial">
                            Partial
                          </option>
                          <option value="Implemented">
                            Implemented
                          </option>
                        </select>

                      </td>

                    </tr>

                  ))}

                </tbody>

              </table>

            </div>
          )}

        </div>

        <div className="panel">

          <div className="panel-header">

            <div>
              <h2>Risk ↔ ISO Controls</h2>
              <p>
                Relación entre riesgos y controles ISO 27001
              </p>
            </div>

          </div>

          <div className="form-group">

            <label>Risk</label>

            <select
              value={selectedRisk?.code || ""}
              onChange={(event) => {
                const risk = risks.find(
                  (item) => item.code === event.target.value
                );

                setSelectedRisk(risk || null);
              }}
            >
              <option value="">
                Seleccionar riesgo
              </option>

              {risks.map((risk) => (
                <option
                  key={risk.code}
                  value={risk.code}
                >
                  {risk.code} — {risk.name}
                </option>
              ))}

            </select>

          </div>

          {selectedRisk && (
            <div className="selected-risk">

              <div>
                <strong>{selectedRisk.code}</strong>
                <div className="risk-description">
                  {selectedRisk.name}
                </div>
              </div>

              <RiskBadge
                level={selectedRisk.risk_level}
              />

            </div>
          )}

          <div className="linked-controls">

            <h3>Linked controls</h3>

            {riskISOLoading ? (
              <div className="empty-state">
                Loading relationships...
              </div>
            ) : riskISOControls.length === 0 ? (
              <div className="empty-state">
                No ISO controls linked to this risk.
              </div>
            ) : (
              riskISOControls.map((control) => (

                <div
                  className="linked-control"
                  key={control.code}
                >

                  <div>

                    <strong>{control.code}</strong>

                    <div className="risk-description">
                      {control.name}
                    </div>

                    <small>
                      Treatment:{" "}
                      {control.treatment_status || "Planned"}
                    </small>

                    {control.notes && (
                      <div className="risk-description">
                        {control.notes}
                      </div>
                    )}

                  </div>

                  <button
                    className="secondary-button"
                    disabled={riskISOSaving}
                    onClick={() =>
                      handleDeleteRiskISOControl(
                        control.code
                      )
                    }
                  >
                    Remove
                  </button>

                </div>

              ))
            )}

          </div>

          <div className="link-control-form">

            <h3>Associate ISO control</h3>

            <div className="form-group">

              <label>ISO Control</label>

              <select
                value={selectedISOCode}
                onChange={(event) =>
                  setSelectedISOCode(event.target.value)
                }
                disabled={
                  riskISOSaving ||
                  !selectedRisk ||
                  availableControls.length === 0
                }
              >
                <option value="">
                  Seleccionar control
                </option>

                {availableControls.map((control) => (
                  <option
                    key={control.code}
                    value={control.code}
                  >
                    {control.code} — {control.name}
                  </option>
                ))}

              </select>

            </div>

            <div className="form-group">

              <label>Treatment status</label>

              <select
                value={treatmentStatus}
                onChange={(event) =>
                  setTreatmentStatus(event.target.value)
                }
                disabled={riskISOSaving}
              >
                <option value="Planned">
                  Planned
                </option>
                <option value="In Progress">
                  In Progress
                </option>
                <option value="Implemented">
                  Implemented
                </option>
                <option value="Accepted">
                  Accepted
                </option>
              </select>

            </div>

            <div className="form-group">

              <label>Notes</label>

              <textarea
                value={notes}
                onChange={(event) =>
                  setNotes(event.target.value)
                }
                placeholder="Justificación o evidencia del tratamiento..."
                rows="3"
                disabled={riskISOSaving}
              />

            </div>

            <button
              className="primary-button"
              disabled={
                riskISOSaving ||
                !selectedRisk ||
                !selectedISOCode
              }
              onClick={handleLink}
            >
              {riskISOSaving
                ? "Saving..."
                : "Associate ISO Control"}
            </button>

          </div>

        </div>

      </div>

      {isoSoA && (
        <div className="panel">

          <div className="panel-header">

            <div>
              <h2>Statement of Applicability</h2>
              <p>
                Estado de aplicabilidad de controles
              </p>
            </div>

          </div>

          <pre className="json-preview">
            {JSON.stringify(isoSoA, null, 2)}
          </pre>

        </div>
      )}

    </section>
  );
}


