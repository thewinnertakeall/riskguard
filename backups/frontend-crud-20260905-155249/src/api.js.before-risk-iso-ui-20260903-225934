const API_BASE = "";

async function request(url, options = {}) {
  const response = await fetch(`${API_BASE}${url}`, {
    headers: {
      "Content-Type": "application/json",
      ...(options.headers || {})
    },
    ...options
  });

  if (!response.ok) {
    const text = await response.text();

    throw new Error(
      `API ${response.status}: ${text || response.statusText}`
    );
  }

  return response.json();
}

export async function getRisks() {
  return request("/api/risks");
}

export async function getRiskDashboard() {
  return request("/api/v2/risks");
}

export async function analyzeRisk(riskCode) {
  return request(
    `/api/agents/analyze/${encodeURIComponent(riskCode)}`
  );
}

export async function getRecommendation(riskCode) {
  return request(
    `/api/agents/recommend/${encodeURIComponent(riskCode)}`
  );
}

export async function getSemanticStatus() {
  return request("/api/semantic/status");
}

export async function synchronizeSemanticGraph() {
  return request("/api/semantic/sync", {
    method: "POST"
  });
}

export async function getIncidents() {
  return request("/api/incidents");
}

export async function getISO27001Status() {
  return request("/api/iso27001/status");
}

export async function getISO27001Controls() {
  return request("/api/iso27001/controls");
}

export async function getISO27001Compliance() {
  return request("/api/iso27001/compliance");
}

export async function getISO27001SoA() {
  return request("/api/iso27001/soa");
}


export async function updateISO27001Control(code, data) {
  return request(
    `/api/iso27001/controls/${encodeURIComponent(code)}`,
    {
      method: "PATCH",
      body: JSON.stringify(data)
    }
  );
}
