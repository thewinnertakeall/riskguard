from sqlalchemy import (
    Column,
    Date,
    Float,
    ForeignKey,
    Integer,
    String,
    Text,
    Table
)

from sqlalchemy.orm import relationship

from .database import Base


# ============================================================
# ASSOCIATION TABLES
# ============================================================

risk_causes = Table(
    "risk_causes",
    Base.metadata,
    Column(
        "risk_id",
        Integer,
        ForeignKey("risks.id", ondelete="CASCADE"),
        primary_key=True
    ),
    Column(
        "cause_id",
        Integer,
        ForeignKey("causes.id", ondelete="CASCADE"),
        primary_key=True
    )
)


risk_controls = Table(
    "risk_controls",
    Base.metadata,
    Column(
        "risk_id",
        Integer,
        ForeignKey("risks.id", ondelete="CASCADE"),
        primary_key=True
    ),
    Column(
        "control_id",
        Integer,
        ForeignKey("controls.id", ondelete="CASCADE"),
        primary_key=True
    )
)


risk_incidents = Table(
    "risk_incidents",
    Base.metadata,
    Column(
        "risk_id",
        Integer,
        ForeignKey("risks.id", ondelete="CASCADE"),
        primary_key=True
    ),
    Column(
        "incident_id",
        Integer,
        ForeignKey("incidents.id", ondelete="CASCADE"),
        primary_key=True
    )
)


# ============================================================
# PROCESS
# ============================================================

class Process(Base):
    __tablename__ = "processes"

    id = Column(Integer, primary_key=True, index=True)

    code = Column(
        String(50),
        unique=True,
        nullable=False,
        index=True
    )

    name = Column(
        String(150),
        nullable=False
    )

    description = Column(Text)

    risks = relationship(
        "Risk",
        back_populates="process_object"
    )


# ============================================================
# AREA
# ============================================================

class Area(Base):
    __tablename__ = "areas"

    id = Column(Integer, primary_key=True, index=True)

    code = Column(
        String(50),
        unique=True,
        nullable=False,
        index=True
    )

    name = Column(
        String(150),
        nullable=False
    )

    description = Column(Text)

    risks = relationship(
        "Risk",
        back_populates="area_object"
    )


# ============================================================
# LOCATION
# ============================================================

class Location(Base):
    __tablename__ = "locations"

    id = Column(Integer, primary_key=True, index=True)

    code = Column(
        String(50),
        unique=True,
        nullable=False,
        index=True
    )

    name = Column(
        String(150),
        nullable=False
    )

    description = Column(Text)

    risks = relationship(
        "Risk",
        back_populates="location_object"
    )

    incidents = relationship(
        "Incident",
        back_populates="location"
    )


# ============================================================
# RISK
# ============================================================

class Risk(Base):
    __tablename__ = "risks"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    code = Column(
        String(50),
        unique=True,
        nullable=False,
        index=True
    )

    name = Column(
        String(150),
        nullable=False
    )

    description = Column(Text)

    process_id = Column(
        Integer,
        ForeignKey("processes.id"),
        nullable=True
    )

    area_id = Column(
        Integer,
        ForeignKey("areas.id"),
        nullable=True
    )

    location_id = Column(
        Integer,
        ForeignKey("locations.id"),
        nullable=True
    )

    category = Column(
        String(100),
        nullable=True
    )

    probability = Column(
        Integer,
        nullable=False,
        default=1
    )

    impact = Column(
        Integer,
        nullable=False,
        default=1
    )

    risk_score = Column(
        Integer,
        nullable=False,
        default=1
    )

    risk_level = Column(
        String(50),
        nullable=False,
        default="Low"
    )

    status = Column(
        String(50),
        nullable=False,
        default="Active"
    )

    process_object = relationship(
        "Process",
        back_populates="risks"
    )

    area_object = relationship(
        "Area",
        back_populates="risks"
    )

    location_object = relationship(
        "Location",
        back_populates="risks"
    )

    causes = relationship(
        "Cause",
        secondary=risk_causes,
        back_populates="risks"
    )

    controls = relationship(
        "Control",
        secondary=risk_controls,
        back_populates="risks"
    )

    incidents = relationship(
        "Incident",
        secondary=risk_incidents,
        back_populates="risks"
    )


# ============================================================
# CAUSE
# ============================================================

class Cause(Base):
    __tablename__ = "causes"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    code = Column(
        String(50),
        unique=True,
        nullable=False,
        index=True
    )

    name = Column(
        String(150),
        nullable=False
    )

    description = Column(Text)

    cause_type = Column(
        String(100),
        nullable=True
    )

    status = Column(
        String(50),
        nullable=False,
        default="Active"
    )

    risks = relationship(
        "Risk",
        secondary=risk_causes,
        back_populates="causes"
    )


# ============================================================
# CONTROL
# ============================================================

class Control(Base):
    __tablename__ = "controls"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    code = Column(
        String(50),
        unique=True,
        nullable=False,
        index=True
    )

    name = Column(
        String(150),
        nullable=False
    )

    description = Column(Text)

    control_type = Column(
        String(100),
        nullable=True
    )

    hierarchy_level = Column(
        String(100),
        nullable=True
    )

