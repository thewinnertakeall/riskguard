# ============================================================
# INCIDENT
# ============================================================

class Incident(Base):
    __tablename__ = "incidents"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    code = Column(
        String(50),
        unique=True,
        nullable=False,
        index=True
    )

    title = Column(
        String(200),
        nullable=False
    )

    description = Column(Text)

    incident_date = Column(
        Date,
        nullable=True
    )

    incident_type = Column(
        String(100),
        nullable=True
    )

    severity = Column(
        String(50),
        nullable=True
    )

    location_id = Column(
        Integer,
        ForeignKey("locations.id"),
        nullable=True
    )

    status = Column(
        String(50),
        nullable=False,
        default="Open"
    )

    location = relationship(
        "Location",
        back_populates="incidents"
    )

    risks = relationship(
        "Risk",
        secondary=risk_incidents,
        back_populates="incidents"
    )
