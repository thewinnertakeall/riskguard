@app.post(
    "/api/risks/{risk_id}/causes/{cause_id}"
)
def assign_cause(
    risk_id: int,
    cause_id: int,
    db: Session = Depends(get_db)
):
    result = crud.assign_cause_to_risk(
        db,
        risk_id,
        cause_id
    )

    if not result:
        raise HTTPException(
            status_code=404,
            detail="Risk or cause not found"
        )

    return {
        "message": "Cause assigned to risk",
        "risk_id": risk_id,
        "cause_id": cause_id
    }


