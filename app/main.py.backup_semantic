from fastapi import Depends, FastAPI, HTTPException
from sqlalchemy.orm import Session

from . import crud
from .database import Base, engine, get_db
from .schemas import (
    AreaCreate,
    AreaResponse,
    CauseCreate,
    CauseResponse,
    CauseUpdate,
    ControlCreate,
    ControlResponse,
    ControlUpdate,
    IncidentCreate,
    IncidentResponse,
    IncidentUpdate,
    LocationCreate,
    LocationResponse,
    ProcessCreate,
    ProcessResponse,
    RiskCreate,
    RiskResponse,
    RiskUpdate,
)


Base.metadata.create_all(bind=engine)


app = FastAPI(
    title="RiskGuard - Occupational Risk Management",
    description=(
        "Integrated occupational risk management "
        "API prepared for RDF, OWL, SPARQL, "
        "reasoning and multi-agent intelligence."
    ),
    version="1.1.0"
)


@app.get("/")
def root():
    return {
        "project": "RiskGuard",
        "version": "1.1.0",
        "status": "operational",
        "architecture": [
            "SQL",
            "RDF",
            "OWL",
            "SPARQL",
            "Reasoning",
            "Multi-Agent System"
        ]
    }


# ============================================================
# RISKS
# ============================================================

@app.post(
    "/api/risks",
    response_model=RiskResponse,
    status_code=201
)
def create_risk(
    risk: RiskCreate,
    db: Session = Depends(get_db)
):
    return crud.create_risk(db, risk)


@app.get(
    "/api/risks",
    response_model=list[RiskResponse]
)
def get_risks(
    db: Session = Depends(get_db)
):
    return crud.get_risks(db)


@app.get(
    "/api/risks/{risk_id}",
    response_model=RiskResponse
)
def get_risk(
    risk_id: int,
    db: Session = Depends(get_db)
):
    risk = crud.get_risk(db, risk_id)

    if not risk:
        raise HTTPException(
            status_code=404,
            detail="Risk not found"
        )

    return risk


@app.put(
    "/api/risks/{risk_id}",
    response_model=RiskResponse
)
def update_risk(
    risk_id: int,
    risk: RiskUpdate,
    db: Session = Depends(get_db)
):
    result = crud.update_risk(
        db,
        risk_id,
        risk
    )

    if not result:
        raise HTTPException(
            status_code=404,
            detail="Risk not found"
        )

    return result


@app.delete("/api/risks/{risk_id}")
def delete_risk(
    risk_id: int,
    db: Session = Depends(get_db)
):
    result = crud.delete_risk(
        db,
        risk_id
    )

    if not result:
        raise HTTPException(
            status_code=404,
            detail="Risk not found"
        )

    return {
        "message": "Risk deleted successfully",
        "id": risk_id
    }


