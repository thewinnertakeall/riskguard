@prefix rg: <http://riskguard.org/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://riskguard.org/ontology#incident/INC-002> a rg:Incident ;
    rg:code "INC-002" ;
    rg:description "Se detectó deterioro en el aislamiento durante inspección." ;
    rg:incidentDate "2026-09-05"^^xsd:date ;
    rg:incidentType "Electrical Failure" ;
    rg:locatedIn <http://riskguard.org/ontology#location/LOC-PLANT-01> ;
    rg:severity "High" ;
    rg:status "Open" ;
    rg:title "Fallo de aislamiento eléctrico" .

<http://riskguard.org/ontology#incident/INC-003> a rg:Incident ;
