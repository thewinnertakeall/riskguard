<http://riskguard.org/ontology#area/AREA-IND> a rg:Area ;
    rg:code "AREA-IND" ;
    rg:description "Area where industrial maintenance activities are performed." ;
    rg:name "Industrial Maintenance Area" .

<http://riskguard.org/ontology#cause/CAUSE-001> a rg:Cause ;
    rg:causeType "Unsafe Condition" ;
    rg:code "CAUSE-001" ;
    rg:description "Equipment is not completely isolated before maintenance." ;
    rg:name "Inadequate electrical isolation" ;
    rg:status "Active" .

<http://riskguard.org/ontology#control/CTRL-001> a rg:Control ;
    rg:code "CTRL-001" ;
    rg:controlType "Administrative" ;
    rg:description "Procedure to isolate and lock electrical energy sources." ;
    rg:effectiveness 9e+01 ;
    rg:hierarchyLevel "Administrative Control" ;
    rg:name "Lockout Tagout Procedure" ;
    rg:status "Active" .

<http://riskguard.org/ontology#incident/INC-001> a rg:Incident ;
