    rg:title "Fallo del CRUD" .

<http://riskguard.org/ontology#process/PROC-MAINT-TEST> a rg:Process ;
    rg:code "PROC-MAINT-TEST" ;
    rg:description "Maintenance process" ;
    rg:name "Maintenance" .

<http://riskguard.org/ontology#risk/RISK-001> a rg:Risk ;
    rg:belongsToArea <http://riskguard.org/ontology#area/AREA-IND> ;
    rg:belongsToProcess <http://riskguard.org/ontology#process/PROC-MAINT> ;
    rg:category "Technological" ;
    rg:code "RISK-001" ;
    rg:description "Acceso no autorizado, malware o explotación de vulnerabilidades que comprometan la confidencialidad, integridad o disponibilidad de los sistemas de información." ;
    rg:hasCause <http://riskguard.org/ontology#cause/CAUSE-001> ;
    rg:hasControl <http://riskguard.org/ontology#control/CTRL-001> ;
    rg:hasIncident <http://riskguard.org/ontology#incident/INC-001> ;
    rg:impact 5 ;
    rg:locatedIn <http://riskguard.org/ontology#location/LOC-PLANT-01> ;
    rg:name "Ataque cibernético a los sistemas de información" ;
    rg:probability 4 ;
    rg:riskLevel "Critical" ;
    rg:riskScore 20 ;
    rg:status "Active" .

<http://riskguard.org/ontology#risk/T-NAT-001> a rg:Risk ;
    rg:category "Natural" ;
    rg:code "T-NAT-001" ;
